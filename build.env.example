# Copy to build.env and fill in. Keep build.env out of git (it is in .gitignore).
BAKSMALI_JAR=/path/to/baksmali.jar     # version 2.x
SMALI_JAR=/path/to/smali.jar           # same version family
KEYSTORE=/path/to/my.keystore          # your own key
KEY_ALIAS=myalias
KEY_PASS=changeme
OS=CEEV.CAN.0000.V014.010.250818       # from tools/pull_stock.sh (os line)
MODEL=ceev_ca                          # the head unit model string
